<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
        <link rel="stylesheet" href="/css/auction.css">
</head>

<body>
    <%- include('partials/header') %>
        <%- include('partials/flash') %>

            <main class="auction-wrapper">
                <!-- TOP BANNER HEADER -->
                <header class="auction-header">

                    <h1 class="glitch-title" data-text="AUCTION TABLE">AUCTION <span class="gold-text">TABLE</span>
                    </h1>
                    <p class="auction-subtitle">Bid monthly EP on auction item (banners, chat bubbles, sticker packs or
                        game items)</p>
                </header>

                <!-- LAST WINNER HOTSTAR-STYLE BANNER -->
                <% if (lastWinner && (lastWinner.winner || lastWinner.winnerUsername)) { %>
                    <% const winnerObj=lastWinner.winner || {}; const winnerDisplay=winnerObj.platoId ?
                        `${winnerObj.platoId}` : (winnerObj.username || lastWinner.winnerUsername || 'Anonymous Winner'
                        ); const winnerAvatar=winnerObj.avatar || '/images/default-avatar.png' ; %>
                        <section class="auction-hero-card">
                            <div class="auction-hero-backdrop"></div>
                            <div class="auction-overlay-left"></div>
                            <div class="auction-overlay-bottom"></div>

                            <div class="hud-corner tl"></div>
                            <div class="hud-corner tr"></div>
                            <div class="hud-corner bl"></div>
                            <div class="hud-corner br"></div>

                            <div class="auction-hero-content">
                                <div class="hero-tags">
                                    <span class="hotstar-pill victor-pill">
                                        <i class="fa-solid fa-crown"></i> LAST AUCTION WINNER
                                    </span>
                                    <!-- <span class="hotstar-pill status-pill">
                                        <span class="pulsing-dot"></span> ITEM CLAIMED
                                    </span> -->
                                </div>

                                <div class="winner-identity-row">
                                    <div class="winner-avatar-pod">
                                        <img src="<%= winnerAvatar %>" alt="<%= winnerDisplay %> Avatar"
                                            class="winner-avatar-img"
                                            onerror="this.src='/images/default-avatar.png';" />
                                        <span class="winner-crown-badge">👑</span>
                                    </div>

                                    <div class="winner-text-group">
                                        <h2 class="winner-name-title">
                                            <%= winnerDisplay %>
                                        </h2>
                                        <div class="winner-meta-chips">
                                            <span class="meta-chip">
                                                <i class="fa-solid fa-gift cyan-text"></i> Item Won: <strong
                                                    class="cyan-text">
                                                    <%= lastWinner.itemName %>
                                                </strong>
                                            </span>
                                            <span class="meta-chip">
                                                <i class="fa-solid fa-coins gold-text"></i> Winning Bid: <strong
                                                    class="gold-text">
                                                    <%= (lastWinner.winningBidAmount || 0).toLocaleString() %> EP
                                                </strong>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <% } %>

                            <% if (auction) { %>
                                <% const currentBid=auction.currentHighestBid || auction.startingBid; const
                                    minNextBid=auction.currentHighestBid ? (auction.currentHighestBid + 100) :
                                    auction.startingBid; const topBidderDisplay=auction.highestBidder ?
                                    (auction.highestBidder.platoId ? `${auction.highestBidder.platoId}` :
                                    auction.highestBidder.username) : 'None Yet' ; %>

                                    <!-- ACTIVE AUCTION INTERACTION GRID -->
                                    <div class="auction-grid">
                                        <!-- Left: Item Showcase & Embedded Bids -->
                                        <div class="cyber-card item-card">
                                            <div class="hud-corner tl"></div>
                                            <div class="hud-corner br"></div>

                                            <div class="compact-item-header">
                                                <img src="<%= auction.itemImage %>" alt="<%= auction.itemName %>"
                                                    class="item-thumb-icon" onerror="this.src='/images/atx.webp';">
                                                <div class="item-title-group">
                                                    <div class="live-indicator-pill">
                                                        <span class="pulsing-dot-green"></span> LIVE
                                                    </div>
                                                    <h3 class="gold-text">
                                                        <%= auction.itemName %>
                                                    </h3>
                                                    <button type="button" id="openImageModalBtn"
                                                        class="cyber-btn view-image-btn">
                                                        <i class="fa-solid fa-expand"></i> View item
                                                    </button>
                                                </div>
                                            </div>

                                            <p class="item-desc">
                                                <%= auction.description || 'No item description provided.' %>
                                            </p>

                                            <!-- Embedded Recent Bids Log -->
                                            <div class="embedded-bids-section">
                                                <div class="bids-header-row">
                                                    <h4><i class="fa-solid fa-gavel cyan-text"></i> LIVE BID
                                                        LOG</h4>
                                                    <span class="bid-count-tag">
                                                        <%= (auction.bids && auction.bids.length) ? auction.bids.length
                                                            : 0 %> BIDS
                                                    </span>
                                                </div>

                                                <ul class="bids-list">
                                                    <% if (auction.bids && auction.bids.length> 0) { %>
                                                        <% auction.bids.forEach(bid=> { %>
                                                            <li class="bid-item">
                                                                <div class="bid-user-info">
                                                                    <span class="bidder-name">
                                                                        <i
                                                                            class="fa-solid fa-gavel gold-text bid-icon"></i>
                                                                        <strong>
                                                                            <%= bid.platoId ? `${bid.platoId}` :
                                                                                bid.username %>
                                                                        </strong>
                                                                    </span>
                                                                    <span class="gold-text bid-amount">
                                                                        <%= (bid.amount || 0).toLocaleString() %> EP
                                                                    </span>
                                                                </div>
                                                                <small class="outbid-tag">
                                                                    <% if (bid.outbiddedUser) { %>
                                                                        Outbid <span class="cyan-text">
                                                                            <%= bid.outbiddedUser %>
                                                                        </span>
                                                                        <% } else { %>
                                                                            <span class="gold-text">Opened Initial
                                                                                Bid</span>
                                                                            <% } %>
                                                                </small>
                                                            </li>
                                                            <% }) %>
                                                                <% } else { %>
                                                                    <p class="no-bids-text">No bids dispatched yet. Be
                                                                        the first to claim the lead!</p>
                                                                    <% } %>
                                                </ul>
                                            </div>

                                            <!-- Metrics Footer -->
                                            <div class="auction-metrics">
                                                <div class="metric-box">
                                                    <span class="label">CURRENT HIGHEST BID</span>
                                                    <h4 class="cyan-text">
                                                        <%= currentBid.toLocaleString() %> EP
                                                    </h4>
                                                </div>
                                                <div class="metric-box right">
                                                    <span class="label">LEADING BIDDER</span>
                                                    <h4 class="gold-text">
                                                        <%= topBidderDisplay %>
                                                    </h4>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Right: Bidding Controls Sidebar -->
                                        <div class="auction-sidebar">
                                            <div class="cyber-card action-card">
                                                <div class="hud-corner tl"></div>
                                                <div class="hud-corner br"></div>

                                                <div class="action-card-header">
                                                    <h3><i class="fa-solid fa-hand-holding-dollar gold-text"></i> PLACE
                                                        BID</h3>
                                                </div>

                                                <div class="user-balance-banner">
                                                    <span class="balance-label">AVAILABLE EP BALANCE</span>
                                                    <h3 class="gold-text">
                                                        <%= user ? (user.xpBalance || 0).toLocaleString() : 0 %> EP
                                                    </h3>
                                                </div>

                                                <% if (user) { %>
                                                    <!-- Option 1: Quick Regular Bid (+100 EP) -->
                                                    <form action="/auction/bid" method="POST" class="quick-bid-form">
                                                        <input type="hidden" name="bidType" value="regular">
                                                        <button
                                                            onclick="if(window.AudioEngine) AudioEngine.playBidSound()"
                                                            type="submit" class="hotstar-btn primary-btn quick-bid-btn">
                                                            <i class="fa-solid fa-gavel"></i> Quick Bid +100 (=<%=
                                                                (currentBid + 100).toLocaleString() %> EP)
                                                        </button>
                                                    </form>

                                                    <!-- Option 2: Custom Bid Amount -->
                                                    <form action="/auction/bid" method="POST" class="custom-bid-form">
                                                        <input type="hidden" name="bidType" value="custom">
                                                        <label class="sub-label">BID CUSTOM EP</label>
                                                        <div class="input-group">
                                                            <input type="number" name="customAmount"
                                                                class="cyber-input custom-input"
                                                                placeholder="Min <%= minNextBid %> EP"
                                                                min="<%= minNextBid %>"
                                                                max="<%= user ? user.xpBalance : 0 %>" required>
                                                            <button
                                                                onclick="if(window.AudioEngine) AudioEngine.playBidSound()"
                                                                type="submit" class="hotstar-btn custom-bid-btn">
                                                                Bid
                                                            </button>
                                                        </div>
                                                    </form>
                                                    <% } else { %>
                                                        <a href="/login" class="hotstar-btn primary-btn login-bid-btn">
                                                            <i class="fa-solid fa-right-to-bracket"></i> Login to
                                                            Authorize Bids
                                                        </a>
                                                        <% } %>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Admin Emergency Controls -->
                                    <% if (user && user.role==='admin' ) { %>
                                        <div class="admin-emergency-card">
                                            <div class="admin-header-row">
                                                <h4 class="danger-text"><i class="fa-solid fa-triangle-exclamation"></i>
                                                    ADMIN CONTROL</h4>
                                            </div>
                                            <p class="admin-desc">Manually close this auction session, declare the
                                                highest bidder as the winner, and process EP settlement.</p>
                                            <form action="/auction/admin/end-now" method="POST"
                                                onsubmit="return confirm('Confirm manual conclusion of the active auction?');">
                                                <button type="submit" class="cyber-btn admin-halt-btn">
                                                    <i class="fa-solid fa-power-off"></i> END AUCTION NOW
                                                </button>
                                            </form>
                                        </div>
                                        <% } %>

                                            <% } else { %>
                                                <!-- Fallback when no active auction exists -->
                                                <section class="cyber-card empty-auction-card">
                                                    <div class="empty-icon-pod">
                                                        <i class="fa-solid fa-gavel gold-text"></i>
                                                    </div>
                                                    <h3>NO ACTIVE AUCTION SESSION</h3>
                                                    <p>The auction console is currently idle. Stand by for the upcoming
                                                        weekly deployment!</p>
                                                </section>

                                                <!-- Admin Quick Launch Panel -->
                                                <% if (user && user.role==='admin' ) { %>
                                                    <div class="cyber-card admin-create-card">
                                                        <div class="card-title-bar">
                                                            <div class="title-left">
                                                                <i class="fa-solid fa-rocket cyan-text"></i>
                                                                <h3>START NEW AUCTION</h3>
                                                            </div>

                                                        </div>

                                                        <form action="/auction/admin/create" method="POST"
                                                            enctype="multipart/form-data" class="admin-auction-form">
                                                            <div class="form-group">
                                                                <label class="form-label">Item / Prize
                                                                </label>
                                                                <input type="text" name="itemName" class="cyber-input"
                                                                    placeholder="e.g. Rare Discord Animated Role / Stickers"
                                                                    required>
                                                            </div>

                                                            <div class="form-group">
                                                                <label class="form-label">Item Description /
                                                                    Note</label>
                                                                <textarea name="description" class="cyber-input"
                                                                    rows="3"
                                                                    placeholder="Detail the privileges, duration, or prize parameters..."
                                                                    style="resize: vertical;"></textarea>
                                                            </div>

                                                            <div class="form-row-split">
                                                                <div class="form-group">
                                                                    <label class="form-label">Starting Bid (EP)</label>
                                                                    <input type="number" name="startingBid"
                                                                        class="cyber-input" value="100" min="10"
                                                                        required>
                                                                </div>

                                                                <div class="form-group">
                                                                    <label class="form-label">Upload item Image
                                                                    </label>
                                                                    <input type="file" name="itemImage" accept="image/*"
                                                                        required class="custom-file-input">
                                                                </div>
                                                            </div>

                                                            <button type="submit"
                                                                class="hotstar-btn primary-btn launch-submit-btn">
                                                                <i class="fa-solid fa-rocket"></i> SUBMIT AUCTION
                                                            </button>
                                                        </form>
                                                    </div>
                                                    <% } %>
                                                        <% } %>
            </main>

            <!-- STRUCTURED METADATA INSPECT MODAL -->
            <% if (auction) { %>
                <div id="imageModal" class="auction-image-modal">
                    <div class="modal-content-wrapper">
                        <div class="modal-header">
                            <h4 class="gold-text">
                                <%= auction.itemName %>
                            </h4>
                            <button type="button" id="closeImageModalBtn" class="close-modal-btn" title="Close View">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>

                        <div class="modal-body-container">
                            <div class="modal-meta-details">
                                <div class="meta-row">
                                    <span class="meta-key">Initial Bid:</span>
                                    <span class="meta-val gold-text">
                                        <%= auction.startingBid.toLocaleString() %> EP
                                    </span>
                                </div>
                                <div class="meta-row">
                                    <span class="meta-key">Current Bid:</span>
                                    <span class="meta-val cyan-text">
                                        <%= (auction.currentHighestBid || auction.startingBid).toLocaleString() %> EP
                                    </span>
                                </div>
                                <div class="meta-row">
                                    <span class="meta-key">Description:</span>
                                    <span class="meta-val meta-desc">
                                        <%= auction.description || 'No description provided.' %>
                                    </span>
                                </div>
                            </div>

                            <div class="modal-image-wrapper">
                                <img src="<%= auction.itemImage %>" alt="<%= auction.itemName %>" class="modal-full-img"
                                    onerror="this.src='/images/atx.webp';">
                            </div>
                        </div>
                    </div>
                </div>
                <% } %>



                    <script>
                        document.addEventListener('DOMContentLoaded', () => {
                            const modal = document.getElementById('imageModal');
                            const openBtn = document.getElementById('openImageModalBtn');
                            const closeBtn = document.getElementById('closeImageModalBtn');
                            const modalImg = document.querySelector('.modal-full-img');
                            const modalImgWrapper = document.querySelector('.modal-image-wrapper');

                            function calculateImageAspectRatio() {
                                if (!modalImg || !modalImgWrapper) return;
                                const naturalWidth = modalImg.naturalWidth;
                                const naturalHeight = modalImg.naturalHeight;

                                if (naturalWidth && naturalHeight) {
                                    const ratio = naturalWidth / naturalHeight;
                                    if (ratio > 1.15) {
                                        modalImgWrapper.classList.add('landscape-mode');
                                        modalImgWrapper.classList.remove('portrait-mode');
                                    } else {
                                        modalImgWrapper.classList.add('portrait-mode');
                                        modalImgWrapper.classList.remove('landscape-mode');
                                    }
                                }
                            }

                            if (modalImg) {
                                if (modalImg.complete) {
                                    calculateImageAspectRatio();
                                } else {
                                    modalImg.addEventListener('load', calculateImageAspectRatio);
                                }
                            }

                            if (openBtn && modal) {
                                openBtn.addEventListener('click', () => {
                                    modal.classList.add('active');
                                    calculateImageAspectRatio();
                                });
                            }

                            if (closeBtn && modal) {
                                closeBtn.addEventListener('click', () => {
                                    modal.classList.remove('active');
                                });
                            }

                            if (modal) {
                                modal.addEventListener('click', (e) => {
                                    if (e.target === modal) {
                                        modal.classList.remove('active');
                                    }
                                });
                            }
                        });
                    </script>

                    <!-- 320x50 ADSTERRA BANNER -->
                    <div class="adsterra-banner-container"
                        style="display: flex; justify-content: center; align-items: center; margin: 1rem 0; width: 100%; min-height: 50px; overflow: hidden;">
                        <script>
                            atOptions = {
                                'key': '9019d2b26f252f4c581c4f2432bac432',
                                'format': 'iframe',
                                'height': 50,
                                'width': 320,
                                'params': {}
                            };
                        </script>
                        <script
                            src="https://www.highperformanceformat.com/9019d2b26f252f4c581c4f2432bac432/invoke.js"></script>
                    </div>
                    <%- include('partials/footer') %>
</body>

</html>