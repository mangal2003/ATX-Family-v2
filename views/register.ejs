<!DOCTYPE html>
<html lang="en">

<head><%- include('partials/head') %></head>

<body>
    <%- include('partials/header') %>
        <%- include('partials/flash') %>

            <main class="container">
                <div class="cyber-card" style="max-width: 420px; margin: 2rem auto; text-align: center;">
                    <h1 style="margin-bottom: 0.5rem;"><span class="gold-text">CREATE</span> ACCOUNT</h1>
                    <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">
                        One-click registration powered by Google OAuth.
                    </p>

                    <!-- Google OAuth Registration -->
                    <a href="/auth/google" class="cyber-btn"
                        style="background: #ffffff; color: #000000; border: none; font-weight: bold; width: 100%; justify-content: center;">
                        <i class="fa-brands fa-google" style="color: #ea4335;"></i> Register with Google
                    </a>

                    <p style="margin-top: 1.5rem; font-size: 0.85rem; color: var(--text-muted);">
                        Already registered? <a href="/login" style="color: var(--accent-cyan);">Login here</a>.
                    </p>
                </div>
            </main>

            <%- include('partials/footer') %>
</body>

</html>