<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
        <link rel="stylesheet" href="/css/admin-team.css">
</head>

<body>
    <%- include('partials/header') %>
        <%- include('partials/flash') %>

            <main class="team-wrapper">
                <!-- COMMAND ROSTER HEADER -->
                <header class="team-header">
                    <h1 class="glitch-title" data-text="ATX ADMIN TEAM">ATX ADMIN <span class="gold-text">TEAM</span>
                    </h1>
                    <p class="team-subtitle">Leadership, tournament coordinators and
                        platform moderators.</p>
                </header>

                <!-- ADMIN GRID MATRIX -->
                <section class="team-grid">
                    <% admins.forEach(admin=> { %>
                        <% const adminData=JSON.stringify(admin).replace(/'/g, "&#39;" ); %>

                            <article class="admin-card" onclick="openViewModal('<%= adminData %>')">
                                <!-- High-Tech Corner HUD Brackets -->
                                <div class="hud-corner tl"></div>
                                <div class="hud-corner br"></div>

                                <!-- Editable Trigger (Visible to logged-in admins) -->
                                <% if (currentUser && currentUser.role==='admin' ) { %>
                                    <button type="button" class="card-edit-btn" title="Edit Profile"
                                        onclick="event.stopPropagation(); openEditModal('<%= adminData %>')">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                    <% } %>

                                        <div class="card-top-bar">
                                            <span
                                                class="rank-badge rank-<%= (admin.adminshipRole || 'Admin').toLowerCase() %>">
                                                <i
                                                    class="fa-solid <%= (admin.adminshipRole === 'Owner') ? 'fa-crown' : ((admin.adminshipRole === 'Moderator') ? 'fa-gavel' : 'fa-shield') %>"></i>
                                                <%= admin.adminshipRole || 'Admin' %>
                                            </span>
                                        </div>

                                        <div
                                            class="avatar-frame rank-ring-<%= (admin.adminshipRole || 'Admin').toLowerCase() %>">
                                            <img src="<%= admin.avatar || '/images/default-avatar.png' %>"
                                                alt="<%= admin.displayName || admin.username %>"
                                                onerror="this.src='/images/default-avatar.png';" loading="lazy">
                                        </div>

                                        <h3 class="admin-name">
                                            <%= admin.displayName || admin.username %>
                                        </h3>

                                        <p class="admin-bio-snippet">
                                            <%= admin.bio || 'ATX Command Team Member' %>
                                        </p>

                                        <div class="card-footer-cta">
                                            <span class="view-profile-label">VIEW CREDENTIALS <i
                                                    class="fa-solid fa-arrow-right-long"></i></span>
                                        </div>
                            </article>
                            <% }) %>
                </section>


                <!-- FORMER ADMINS & VETERAN TRIBUTE HORIZONTAL SCROLLING RAIL -->
                <section class="veterans-tribute-section">
                    <div class="veterans-card">
                        <div class="veterans-ambient-glow"></div>
                        <div class="hud-corner tl"></div>
                        <div class="hud-corner tr"></div>
                        <div class="hud-corner bl"></div>
                        <div class="hud-corner br"></div>

                        <div class="veterans-header">
                            <div class="tribute-seal-icon">
                                <i class="fa-solid fa-award gold-text"></i>
                            </div>
                            <h2 class="tribute-title">WITH ETERNAL GRATITUDE</h2>
                            <p class="tribute-subtitle">
                                Honoring the former admins, tournament hosts and sponsors, and community architects who
                                built the
                                foundation of ATX
                            </p>
                        </div>

                        <% let formerAdminsList=[]; if (locals.siteSettings && siteSettings.customMetrics) { const
                            metric=siteSettings.customMetrics.find(m=> m.label === 'formerAdmins');
                            if (metric && metric.value) {
                            formerAdminsList = metric.value.split(',').map(name => name.trim()).filter(Boolean);
                            }
                            }
                            %>

                            <% if (formerAdminsList.length> 0) { %>
                                <!-- Infinite Scrolling Marquee Track Container -->
                                <div class="marquee-wrapper">
                                    <div class="marquee-track">
                                        <!-- Original Array Loop -->
                                        <% formerAdminsList.forEach(name=> { %>
                                            <div class="veteran-name-chip">
                                                <div class="chip-shield-icon">
                                                    <i class="fa-solid fa-user-shield"></i>
                                                </div>
                                                <span class="chip-admin-name">
                                                    <%= name %>
                                                </span>
                                                <span class="chip-honor-tag"><i
                                                        class="fa-solid fa-award gold-text"></i></span>
                                            </div>
                                            <% }) %>

                                                <!-- Duplicate Loop to Ensure Seamless Infinite Loop -->
                                                <% formerAdminsList.forEach(name=> { %>
                                                    <div class="veteran-name-chip" aria-hidden="true">
                                                        <div class="chip-shield-icon">
                                                            <i class="fa-solid fa-user-shield"></i>
                                                        </div>
                                                        <span class="chip-admin-name">
                                                            <%= name %>
                                                        </span>
                                                        <span class="chip-honor-tag"><i
                                                                class="fa-solid fa-award gold-text"></i></span>
                                                    </div>
                                                    <% }) %>
                                    </div>
                                </div>
                                <% } else { %>
                                    <p class="no-veterans-text">No former staff records archived.</p>
                                    <% } %>

                                        <div class="veterans-footer">
                                            <span class="quote-text">
                                                <i class="fa-solid fa-quote-left gold-text"></i> Once ATX Staff, Forever
                                                Royalty. <i class="fa-solid fa-quote-right gold-text"></i>
                                            </span>
                                        </div>
                    </div>
                </section>

            </main>

            <!-- ROYALTY SHOWCASE PROFILE MODAL -->
            <div id="viewModal" class="cyber-modal">
                <div class="royalty-modal-card">
                    <!-- Background Banner Backplate -->
                    <div class="modal-banner-wrap">
                        <img src="/images/gc-banner.webp" alt="ATX Banner" class="modal-banner-img" id="viewBanner"
                            onerror="this.onerror=null; this.src='/images/gc-banner.webp';">
                        <div class="banner-overlay"></div>
                        <button class="royalty-close-btn" onclick="closeModal('viewModal')">&times;</button>
                    </div>

                    <!-- Modal Body Content -->
                    <div class="royalty-body">
                        <div class="royalty-avatar-wrapper">
                            <div class="royalty-avatar-ring" id="viewAvatarRing">
                                <img id="viewAvatar" src="" alt="Admin Avatar">
                            </div>
                        </div>

                        <div class="royalty-header-info">
                            <h2 id="viewName" class="royalty-title"></h2>
                            <div class="rank-badge-wrap">
                                <span id="viewRank" class="royalty-rank-badge"></span>
                            </div>
                        </div>

                        <div class="royalty-bio-box">
                            <span class="bio-label"><i class="fa-solid fa-quote-left gold-text"></i> BIO</span>
                            <p id="viewBio" class="bio-text"></p>
                        </div>

                        <div class="royalty-credentials-grid">
                            <div class="credential-card discord-card">
                                <div class="credential-icon">
                                    <i class="fa-brands fa-discord"></i>
                                </div>
                                <div class="credential-details">
                                    <span class="credential-label">DISCORD ID</span>
                                    <span id="viewDiscord" class="credential-value"></span>
                                </div>
                            </div>

                            <div class="credential-card plato-card">
                                <div class="credential-icon">
                                    <i class="fa-solid fa-gamepad"></i>
                                </div>
                                <div class="credential-details">
                                    <span class="credential-label">PLATO ID</span>
                                    <span id="viewPlato" class="credential-value"></span>
                                </div>
                            </div>
                        </div>

                        <div class="royalty-footer-seal">
                            <i class="fa-solid fa-shield-halved gold-text"></i> ATX ADMIN
                        </div>
                    </div>
                </div>
            </div>

            <!-- PROFILE EDIT MODAL (ADMINS ONLY) -->
            <% if (currentUser && currentUser.role==='admin' ) { %>
                <div id="editModal" class="cyber-modal">
                    <div class="modal-content">
                        <button class="modal-close" onclick="closeModal('editModal')">&times;</button>
                        <div class="modal-header-bar">
                            <h3><i class="fa-solid fa-sliders gold-text"></i> EDIT ADMIN PROFILE</h3>
                        </div>

                        <form action="/admin-team/update-profile" method="POST">
                            <input type="hidden" name="targetUserId" id="editUserId">

                            <div class="modal-field-group">
                                <label>Adminship Role</label>
                                <select name="adminshipRole" id="editRole" class="form-input">
                                    <option value="Owner">Owner</option>
                                    <option value="Admin">Admin</option>
                                    <option value="Moderator">Moderator</option>
                                </select>
                            </div>

                            <div class="modal-field-group">
                                <label>Discord ID</label>
                                <input type="text" name="discordId" id="editDiscord" class="form-input"
                                    placeholder="username#0000">
                            </div>

                            <div class="modal-field-group">
                                <label>Plato ID</label>
                                <input type="text" name="platoId" id="editPlato" class="form-input"
                                    placeholder="Plato Handle">
                            </div>

                            <div class="modal-field-group">
                                <label>Bio</label>
                                <textarea name="bio" id="editBio" class="form-input" rows="3"
                                    placeholder="Brief admin bio..."></textarea>
                            </div>

                            <button type="submit" class="cyber-btn modal-submit-btn">
                                <i class="fa-solid fa-floppy-disk"></i> Save Updates
                            </button>
                        </form>
                    </div>
                </div>
                <% } %>

                    <script>
                        function openViewModal(rawAdmin) {
                            const admin = typeof rawAdmin === 'string' ? JSON.parse(rawAdmin) : rawAdmin;

                            const viewBannerEl = document.getElementById('viewBanner');
                            viewBannerEl.src = (admin.banner && admin.banner.trim() !== '')
                                ? admin.banner
                                : '/images/gc-banner.webp';

                            document.getElementById('viewAvatar').src = admin.avatar || '/images/default-avatar.png';
                            document.getElementById('viewName').innerText = admin.displayName || admin.username;
                            document.getElementById('viewBio').innerText = admin.bio || 'ATX Command Team Member.';
                            document.getElementById('viewDiscord').innerText = admin.discordId || 'Not linked';
                            document.getElementById('viewPlato').innerText = admin.platoId || 'Not linked';

                            const rankElem = document.getElementById('viewRank');
                            const role = admin.adminshipRole || 'Admin';
                            rankElem.innerText = role;

                            rankElem.className = 'royalty-rank-badge';
                            if (role === 'Owner') rankElem.classList.add('rank-owner-glow');
                            else if (role === 'Moderator') rankElem.classList.add('rank-moderator-glow');
                            else rankElem.classList.add('rank-admin-glow');

                            document.getElementById('viewModal').classList.add('active');
                        }

                        function openEditModal(rawAdmin) {
                            const admin = typeof rawAdmin === 'string' ? JSON.parse(rawAdmin) : rawAdmin;
                            document.getElementById('editUserId').value = admin._id;
                            document.getElementById('editRole').value = admin.adminshipRole || 'Admin';
                            document.getElementById('editDiscord').value = admin.discordId || '';
                            document.getElementById('editPlato').value = admin.platoId || '';
                            document.getElementById('editBio').value = admin.bio || '';

                            document.getElementById('editModal').classList.add('active');
                        }

                        function closeModal(modalId) {
                            document.getElementById(modalId).classList.remove('active');
                        }

                        window.onclick = function (event) {
                            if (event.target.classList.contains('cyber-modal')) {
                                event.target.classList.remove('active');
                            }
                        };
                    </script>


                    <!-- 320x50 ADSTERRA BANNER -->
                    <div class="adsterra-banner-container"
                        style="display: flex; justify-content: center; align-items: center; margin: 1rem 0; width: 100%; min-height: 50px; overflow: hidden;">
                        <script>
                            atOptions = {
                                'key': '9019d2b26f252f4c581c4f2432bac432',
                                'format': 'iframe',
                                'height': 50,
                                'width': 320,
                                'params': {}
                            };
                        </script>
                        <script
                            src="https://www.highperformanceformat.com/9019d2b26f252f4c581c4f2432bac432/invoke.js"></script>
                    </div>
                    <%- include('partials/footer') %>
</body>

</html>