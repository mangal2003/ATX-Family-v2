<!DOCTYPE html>
<html lang="en">

<head><%- include('partials/head') %></head>

<body>
    <%- include('partials/header') %>
        <%- include('partials/flash') %>

            <main class="container">
                <div class="cyber-card" style="max-width: 420px; margin: 2rem auto; text-align: center;">
                    <h1 style="margin-bottom: 0.5rem;"><span class="gold-text">ACCESS</span> PORTAL</h1>
                    <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">
                        Sign in to your account or register automatically using Google.
                    </p>

                    <!-- Google OAuth Button -->
                    <a href="/auth/google" class="cyber-btn"
                        style="background: #ffffff; color: #000000; border: none; font-weight: bold; width: 100%; justify-content: center; margin-bottom: 1rem;">
                        <i class="fa-brands fa-google" style="color: #ea4335;"></i> Sign in with Google
                    </a>

                    <div style="margin: 1.5rem 0; border-bottom: 1px solid var(--border-color); position: relative;">
                        <span
                            style="position: absolute; top: -10px; left: 50%; transform: translateX(-50%); background: var(--bg-card); padding: 0 0.5rem; color: var(--text-muted); font-size: 0.75rem;">NEW
                            USER?</span>
                    </div>

                    <p style="font-size: 0.85rem; color: var(--text-muted);">
                        Don't have an account? Signing in with Google automatically registers a new account for you.
                    </p>
                </div>
            </main>

            <%- include('partials/footer') %>
</body>

</html>