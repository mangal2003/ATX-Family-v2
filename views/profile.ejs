<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>
        <%= user.username || User %> | Profile
    </title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Plus+Jakarta+Sans:wght@500;700;800&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/profile.css">
</head>

<body>

    <div class="profile-container">
        <div class="profile-card">

            <!-- HUD Corner Brackets -->
            <div class="hud-corner tl"></div>
            <div class="hud-corner tr"></div>
            <div class="hud-corner bl"></div>
            <div class="hud-corner br"></div>

            <!-- Banner Area -->
            <div class="profile-banner-wrapper">
                <% if (user.banner) { %>
                    <img src="<%= user.banner %>" alt="Profile Banner" class="profile-banner-img">
                    <% } else { %>
                        <div class="profile-banner-placeholder"></div>
                        <% } %>
                            <div class="banner-cinematic-mask"></div>

                            <!-- Streak Pill -->
                            <div class="streak-pill">
                                <span class="fire-icon">🔥</span>
                                <span>
                                    <%= user.streak || 1 %> DAY STREAK
                                </span>
                            </div>
            </div>

            <!-- Header Content & Elevated Avatar -->
            <div class="profile-header-content">
                <div class="avatar-ring-pod">
                    <% if (user.avatar) { %>
                        <img src="<%= user.avatar %>" alt="<%= user.username %>" class="user-avatar"
                            onerror="this.onerror=null; this.src='/images/gc-banner.webp';">
                        <% } else { %>
                            <div class="user-avatar-fallback">
                                <%= user.username.charAt(0).toUpperCase() %>
                            </div>
                            <% } %>
                </div>

                <div class="user-details">
                    <h2>
                        <%= user.username %>
                    </h2>
                    <div class="user-email">
                        <span>✉</span>
                        <%= user.email %>
                    </div>
                    <% if (user.bio) { %>
                        <div class="user-bio-preview">
                            "<%= user.bio %>"
                        </div>
                        <% } %>
                </div>
            </div>

            <hr class="profile-divider">

            <!-- Stats Grid -->
            <div class="profile-stats-grid">
                <div class="stat-card">
                    <div class="stat-icon-pod gold-icon">👑</div>
                    <div class="stat-info">
                        <span class="stat-label">PLATFORM ROLE</span>
                        <h4>
                            <%= (user.role || 'Member' ).toUpperCase() %>
                        </h4>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon-pod cyan-icon">🎮</div>
                    <div class="stat-info">
                        <span class="stat-label">QUIZZES DONE</span>
                        <h4>
                            <%= user.quizzesCompleted || 0 %>
                        </h4>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon-pod gold-icon">🏆</div>
                    <div class="stat-info">
                        <span class="stat-label">WEEKLY SCORE</span>
                        <h4>
                            <%= user.weeklyScore || 0 %>
                        </h4>
                    </div>
                </div>
            </div>

            <!-- VAULT & BOT TELEMETRY COMPONENT -->
            <section class="telemetry-section">
                <div class="telemetry-header">
                    <div class="telemetry-title">
                        <span>💎</span> Vault & Bot Telemetry
                    </div>

                    <div>
                        <% if (user.discordId) { %>
                            <div class="telemetry-badge badge-connected">
                                <span class="badge-dot green"></span> ATX Discord Linked
                            </div>
                            <% } else { %>
                                <div class="telemetry-badge badge-disconnected">
                                    <span class="badge-dot amber"></span> Unlinked • ATX Server
                                </div>
                                <% } %>
                    </div>
                </div>

                <!-- 3-Column Boxes -->
                <div class="telemetry-grid">
                    <!-- 1. Web Vault XP -->
                    <div class="telemetry-box">
                        <div class="telemetry-tag">
                            <span>Website Vault XP</span>
                            <span>🌐</span>
                        </div>
                        <div class="telemetry-val">
                            <span id="valWebXp">
                                <%= Number(user.xpBalance || 0).toLocaleString() %>
                            </span>
                            <span class="telemetry-unit">XP</span>
                        </div>
                        <div class="telemetry-foot">Earned via Website Events</div>
                    </div>

                    <!-- 2. Discord Bot EP -->
                    <div class="telemetry-box">
                        <div class="telemetry-tag">
                            <span>Discord Bot EP</span>
                            <span>⚔️</span>
                        </div>
                        <div class="telemetry-val cyan">
                            <span id="valBotEp">
                                <%= Number(botEp || 0).toLocaleString() %>
                            </span>
                            <span class="telemetry-unit">EP</span>
                        </div>
                        <div class="telemetry-foot">Earned via ATX Mini-Games</div>
                    </div>

                    <!-- 3. Grand Combined EP -->
                    <div class="telemetry-box box-gold">
                        <div class="telemetry-tag">
                            <span>Grand Combined Net</span>
                            <span>👑</span>
                        </div>
                        <div class="telemetry-val gold">
                            <span id="valTotalNet">
                                <%= Number(totalCombinedEp || 0).toLocaleString() %>
                            </span>
                            <span class="telemetry-unit">EP</span>
                        </div>
                        <div class="telemetry-foot">Unified Global Balance</div>
                    </div>
                </div>

                <!-- Connection / Sync Bar -->
                <div class="sync-bar">
                    <% if (!user.discordId) { %>
                        <div>
                            <span>Verification Token:</span>
                            <strong class="sync-code-chip">
                                <%= user.connectionCode || 'EXPIRED' %>
                            </strong>
                            <span style="margin-left: 0.5rem; font-size: 0.72rem;">(Run
                                <code>/connectweb code:...</code> in ATX Discord)</span>
                        </div>
                        <a href="https://discord.gg/atxfamily" target="_blank" class="hotstar-btn join-link-btn">
                            Join Server
                        </a>
                        <% } else { %>
                            <div>
                                <span>Linked Discord Operator:</span>
                                <span style="color: var(--accent-cyan, #00f3ff);">
                                    <%= user.discordId %>
                                </span>
                            </div>
                            <button type="button" onclick="refreshBalances()" class="sync-btn" id="syncBtn">
                                <span id="syncIcon">⟳</span> SYNC BALANCES
                            </button>
                            <% } %>
                </div>
            </section>

            <hr class="profile-divider">

            <!-- Customization Forms -->
            <div class="customization-sections">
                <!-- Bio & Identity Form -->
                <form action="/profile/update" method="POST" class="profile-form">
                    <label class="form-label">
                        <span>⚙</span> OPERATOR DETAILS
                    </label>
                    <div class="form-group-row">
                        <div class="form-group">
                            <span class="sub-label">PLATO CALLSIGN ID</span>
                            <input type="text" name="platoId" value="<%= user.platoId || '' %>"
                                placeholder="Enter Plato ID" class="cyber-input">
                        </div>
                        <div class="form-group">
                            <span class="sub-label">COMMUNITY BIO</span>
                            <input type="text" name="bio" value="<%= user.bio || '' %>"
                                placeholder="Brief quote or battle status" class="cyber-input">
                        </div>
                    </div>
                    <button type="submit" class="hotstar-btn" style="align-self: flex-start; margin-top: 0.5rem;">
                        SAVE PROFILE
                    </button>
                </form>

                <hr class="profile-divider">

                <!-- Avatar & Banner Upload -->
                <form action="/profile/upload-media" method="POST" enctype="multipart/form-data" class="profile-form">
                    <label class="form-label">
                        <span>🖼</span> VISUAL CUSTOMIZATION
                    </label>
                    <div class="form-group-row">
                        <div class="form-group">
                            <span class="sub-label">CUSTOM AVATAR</span>
                            <div class="file-upload-wrapper">
                                <label for="avatarInput" class="custom-file-btn" id="avatarLabel">
                                    <span>📁</span> Select Picture
                                </label>
                                <input type="file" name="avatar" id="avatarInput" accept="image/*"
                                    onchange="document.getElementById('avatarLabel').innerText = this.files[0]?.name || 'Select Picture'">
                            </div>
                        </div>

                        <div class="form-group">
                            <span class="sub-label">BANNER ARTWORK</span>
                            <div class="file-upload-wrapper">
                                <label for="bannerInput" class="custom-file-btn" id="bannerLabel">
                                    <span>📁</span> Select Banner
                                </label>
                                <input type="file" name="banner" id="bannerInput" accept="image/*"
                                    onchange="document.getElementById('bannerLabel').innerText = this.files[0]?.name || 'Select Banner'">
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="hotstar-btn upload-action-btn"
                        style="align-self: flex-start; margin-top: 0.5rem;">
                        UPLOAD MEDIA
                    </button>
                </form>
            </div>

        </div>
    </div>

    <script>
        async function refreshBalances() {
            const syncIcon = document.getElementById('syncIcon');
            if (syncIcon) syncIcon.style.display = 'inline-block';
            if (syncIcon) syncIcon.style.transform = 'rotate(360deg)';
            if (syncIcon) syncIcon.style.transition = 'transform 0.5s ease';

            try {
                const res = await fetch('/api/user/balance-sync');
                if (!res.ok) throw new Error('Network error');
                const data = await res.json();

                if (data.success) {
                    document.getElementById('valWebXp').innerText = Number(data.webXp || 0).toLocaleString();
                    document.getElementById('valBotEp').innerText = Number(data.botBalance || 0).toLocaleString();
                    document.getElementById('valTotalNet').innerText = Number(data.totalBalance || 0).toLocaleString();
                }
            } catch (err) {
                console.error('Balance sync failed:', err);
            } finally {
                setTimeout(() => {
                    if (syncIcon) syncIcon.style.transform = 'rotate(0deg)';
                }, 500);
            }
        }
    </script>

</body>

</html>