<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
        <link rel="stylesheet" href="/css/profile.css">
        <style>
            .connect-discord-card {
                background: rgba(88, 101, 242, 0.08);
                border: 1px dashed #5865f2;
                border-radius: 12px;
                padding: 1.25rem;
                margin-top: 1.25rem;
                text-align: center;
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 0.6rem;
            }

            .code-display-box {
                font-family: 'Share Tech Mono', monospace;
                font-size: 1.75rem;
                letter-spacing: 6px;
                color: #ffd700;
                background: #0a0b10;
                border: 2px solid #ffd700;
                padding: 0.5rem 1.5rem;
                border-radius: 8px;
                display: inline-block;
                margin: 0.4rem 0;
            }
        </style>
</head>

<body>
    <%- include('partials/header') %>
        <%- include('partials/flash') %>

            <main class="profile-container">
                <!-- MAIN PROFILE HUD CARD -->
                <div class="cyber-card profile-card">
                    <div class="hud-corner tl"></div>
                    <div class="hud-corner tr"></div>
                    <div class="hud-corner bl"></div>
                    <div class="hud-corner br"></div>

                    <!-- Cinematic Banner -->
                    <div class="profile-banner-wrapper">
                        <% if (user.banner && user.banner.trim() !=='' ) { %>
                            <img src="<%= user.banner %>" alt="Profile Banner" class="profile-banner-img"
                                loading="lazy">
                            <% } else { %>
                                <div class="profile-banner-placeholder"></div>
                                <% } %>
                                    <div class="banner-cinematic-mask"></div>

                                    <div class="streak-pill">
                                        <i class="fa-solid fa-fire fire-icon"></i>
                                        <span>
                                            <%= user.streak || 1 %> DAYS STREAK
                                        </span>
                                    </div>
                    </div>

                    <!-- Profile Header -->
                    <div class="profile-header-content">
                        <div class="avatar-ring-pod">
                            <% if (user.avatar && user.avatar.trim() !=='' ) { %>
                                <img src="<%= user.avatar %>" alt="<%= user.username %>" class="user-avatar"
                                    referrerpolicy="no-referrer"
                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                <div class="user-avatar-fallback" style="display: none;">
                                    <i class="fa-solid fa-user"></i>
                                </div>
                                <% } else { %>
                                    <div class="user-avatar-fallback">
                                        <i class="fa-solid fa-user"></i>
                                    </div>
                                    <% } %>
                        </div>

                        <div class="user-details">
                            <h2 class="glitch-title gold-text" data-text="<%= user.username %>">
                                <%= user.username %>
                            </h2>
                            <p class="user-email">
                                <i class="fa-regular fa-envelope cyan-text"></i>
                                <%= user.email %>
                            </p>
                            <% if (user.bio) { %>
                                <p class="user-bio-preview">"<%= user.bio %>"</p>
                                <% } %>
                        </div>
                    </div>

                    <hr class="profile-divider">

                    <!-- Stats Grid: Includes Web EP, Discord Bot EP, and Combined Total -->
                    <!-- Unified EP Display Widget -->
                    <div class="bg-[#121722] border border-gray-800 rounded-2xl p-6 mb-6">
                        <div class="flex items-center justify-between mb-4">
                            <h3
                                class="text-white font-extrabold text-sm uppercase tracking-wider flex items-center gap-2">
                                <span class="text-cyan-400">💎</span> Vault & Bot Telemetry
                            </h3>
                            <% if (user.discordId) { %>
                                <span
                                    class="px-2.5 py-1 rounded-full text-[11px] font-mono font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
                                    ● ATX Linked
                                </span>
                                <% } else { %>
                                    <span
                                        class="px-2.5 py-1 rounded-full text-[11px] font-mono font-bold bg-amber-500/10 text-amber-400 border border-amber-500/30">
                                        ○ Unlinked
                                    </span>
                                    <% } %>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                            <!-- Web Vault XP -->
                            <div class="bg-[#0b0e14] p-4 rounded-xl border border-gray-800">
                                <div class="text-[11px] text-gray-500 uppercase font-mono mb-1">Website Vault XP</div>
                                <div class="text-xl sm:text-2xl font-black text-white font-mono">
                                    <%= (user.xpBalance || 0).toLocaleString() %> <span
                                            class="text-xs text-gray-400">XP</span>
                                </div>
                            </div>

                            <!-- Discord Bot Balance -->
                            <div class="bg-[#0b0e14] p-4 rounded-xl border border-gray-800">
                                <div class="text-[11px] text-cyan-400 uppercase font-mono mb-1">Discord Bot EP</div>
                                <div class="text-xl sm:text-2xl font-black text-cyan-300 font-mono">
                                    <%= botEp.toLocaleString() %> <span class="text-xs text-gray-400">EP</span>
                                </div>
                            </div>

                            <!-- Combined Net -->
                            <div
                                class="bg-[#0b0e14] p-4 rounded-xl border border-cyan-500/40 shadow-sm shadow-cyan-500/10">
                                <div class="text-[11px] text-amber-400 uppercase font-mono mb-1">Grand Combined EP</div>
                                <div class="text-xl sm:text-2xl font-black text-amber-300 font-mono">
                                    <%= totalCombinedEp.toLocaleString() %> <span
                                            class="text-xs text-gray-400">EP</span>
                                </div>
                            </div>
                        </div>

                        <% if (!user.discordId) { %>
                            <div
                                class="mt-4 pt-4 border-t border-gray-800 flex flex-col sm:flex-row items-center justify-between gap-3">
                                <p class="text-xs text-gray-400">
                                    Join the <strong class="text-white">ATX Official Discord</strong> and type <code
                                        class="text-cyan-400">/connectweb code:<%= user.connectionCode || 'XXXXXX' %></code>
                                </p>
                                <a href="https://discord.gg/atxfamily" target="_blank"
                                    class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs rounded-xl transition">
                                    Join ATX Discord
                                </a>
                            </div>
                            <% } %>
                    </div>

                    <hr class="profile-divider">

                    <!-- Customization Sections -->
                    <div class="customization-sections">
                        <!-- Discord Bot Link Widget -->
                        <div class="connect-discord-card">
                            <div
                                style="display: flex; align-items: center; gap: 0.5rem; color: #5865f2; font-weight: bold; font-family: 'Share Tech Mono', monospace;">
                                <i class="fa-brands fa-discord"></i> DISCORD BOT INTEGRATION
                            </div>
                            <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0; max-width: 450px;">
                                <% if (user.discordId) { %>
                                    Your account is linked to Discord ID: <strong class="cyan-text">
                                        <%= user.discordId %>
                                    </strong>.
                                    Need to re-link to a new account? Generate a fresh code below.
                                    <% } else { %>
                                        Link your Discord account to combine your mini-game rewards and bot EP with your
                                        website balance!
                                        <% } %>
                            </p>

                            <button type="button" id="generateCodeBtn" class="cyber-btn"
                                style="border-color: #5865f2; color: #5865f2;">
                                <i class="fa-solid fa-key"></i> Generate Link Code
                            </button>

                            <div id="codeDisplayWrapper" style="display: none;">
                                <div class="code-display-box" id="codeBox">------</div>
                                <p style="font-size: 0.75rem; color: var(--accent-gold); margin: 0.2rem 0;">
                                    Type <code>/connectweb &lt;code&gt;</code> in our Discord server within 10 minutes.
                                </p>
                            </div>
                        </div>

                        <!-- 1. Banner Update Form -->
                        <form action="/profile/banner" method="POST" enctype="multipart/form-data" class="profile-form">
                            <label class="form-label">
                                <i class="fa-solid fa-image gold-text"></i> UPDATE BANNER ARTWORK
                            </label>
                            <div class="file-upload-wrapper">
                                <label for="bannerInput" class="custom-file-btn">
                                    <i class="fa-solid fa-folder-open cyan-text"></i>
                                    <span id="bannerFileName">Choose Banner Image...</span>
                                </label>
                                <input type="file" id="bannerInput" name="banner" accept="image/*" required
                                    onchange="document.getElementById('bannerFileName').textContent = this.files[0]?.name || 'Choose Banner Image...';">
                                <button type="submit" class="hotstar-btn primary-btn upload-action-btn">
                                    <i class="fa-solid fa-cloud-arrow-up"></i> Upload
                                </button>
                            </div>
                        </form>

                        <!-- 2. Avatar Update Form -->
                        <form action="/profile/avatar" method="POST" enctype="multipart/form-data" class="profile-form">
                            <label class="form-label">
                                <i class="fa-solid fa-circle-user gold-text"></i> UPDATE AVATAR PICTURE
                            </label>
                            <div class="file-upload-wrapper">
                                <label for="avatarInput" class="custom-file-btn">
                                    <i class="fa-solid fa-folder-open cyan-text"></i>
                                    <span id="avatarFileName">Choose Avatar Image...</span>
                                </label>
                                <input type="file" id="avatarInput" name="avatar" accept="image/*" required
                                    onchange="document.getElementById('avatarFileName').textContent = this.files[0]?.name || 'Choose Avatar Image...';">
                                <button type="submit" class="hotstar-btn primary-btn upload-action-btn">
                                    <i class="fa-solid fa-cloud-arrow-up"></i> Upload
                                </button>
                            </div>
                        </form>

                        <!-- 3. Profile Info Form -->
                        <form action="/profile/update" method="POST" class="profile-form">
                            <label class="form-label">
                                <i class="fa-solid fa-user-pen gold-text"></i> OPERATOR DETAILS & CREDENTIALS
                            </label>

                            <div class="form-group">
                                <label for="username" class="sub-label">Callsign / Username</label>
                                <input type="text" id="username" name="username" value="<%= user.username %>" required
                                    minlength="3" maxlength="25" class="cyber-input">
                            </div>

                            <div class="form-group-row">
                                <div class="form-group">
                                    <label for="platoId" class="sub-label">
                                        <i class="fa-solid fa-gamepad cyan-text"></i> Plato ID
                                    </label>
                                    <input type="text" id="platoId" name="platoId" value="<%= user.platoId || '' %>"
                                        maxlength="12" pattern="^[a-zA-Z0-9_]{1,12}$"
                                        title="Plato ID must be up to 12 characters and contain only letters, numbers, and underscores."
                                        placeholder="e.g. username_99" class="cyber-input">
                                </div>
                                <div class="form-group">
                                    <label for="discordId" class="sub-label">
                                        <i class="fa-brands fa-discord cyan-text"></i> Discord User ID
                                    </label>
                                    <input type="text" id="discordId" name="discordId"
                                        value="<%= user.discordId || '' %>" placeholder="e.g. DISCORD_USN"
                                        class="cyber-input">
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="bio" class="sub-label">Bio</label>
                                <textarea id="bio" name="bio" rows="3" maxlength="250" class="cyber-input"
                                    placeholder="Write something about yourself..."
                                    style="resize: none;"><%= user.bio || '' %></textarea>
                            </div>

                            <button type="submit" class="hotstar-btn primary-btn"
                                style="margin-top: 0.5rem; width: 100%;">
                                <i class="fa-solid fa-floppy-disk"></i> SAVE PROFILE CHANGES
                            </button>
                        </form>
                    </div>
                </div>
            </main>

            <script>
                document.getElementById('generateCodeBtn')?.addEventListener('click', async () => {
                    const btn = document.getElementById('generateCodeBtn');
                    btn.disabled = true;
                    btn.textContent = 'Generating...';

                    try {
                        const res = await fetch('/profile/generate-connect-code', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' }
                        });
                        const data = await res.json();

                        if (data.success) {
                            document.getElementById('codeBox').textContent = data.code;
                            document.getElementById('codeDisplayWrapper').style.display = 'block';
                            btn.textContent = 'Regenerate Code';
                        } else {
                            alert(data.message || 'Failed to generate code.');
                            btn.textContent = 'Generate Link Code';
                        }
                    } catch (err) {
                        console.error(err);
                        alert('Error communicating with the server.');
                        btn.textContent = 'Generate Link Code';
                    } finally {
                        btn.disabled = false;
                    }
                });
            </script>

            <%- include('partials/footer') %>
</body>

</html>