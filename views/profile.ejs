<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
        <link rel="stylesheet" href="/css/profile.css">
</head>

<body>
    <%- include('partials/header') %>
        <%- include('partials/flash') %>

            <main class="profile-container">
                <!-- MAIN PROFILE HUD CARD -->
                <div class="cyber-card profile-card">
                    <!-- Corner HUD Telemetry Decals -->
                    <div class="hud-corner tl"></div>
                    <div class="hud-corner tr"></div>
                    <div class="hud-corner bl"></div>
                    <div class="hud-corner br"></div>

                    <!-- Cinematic Banner Header with Gradient Mask -->
                    <div class="profile-banner-wrapper">
                        <% if (user.banner && user.banner.trim() !=='' ) { %>
                            <img src="<%= user.banner %>" alt="Profile Banner" class="profile-banner-img"
                                loading="lazy">
                            <% } else { %>
                                <div class="profile-banner-placeholder"></div>
                                <% } %>
                                    <div class="banner-cinematic-mask"></div>

                                    <!-- Flame Streak Badge Overlay -->
                                    <div class="streak-pill">
                                        <i class="fa-solid fa-fire fire-icon"></i>
                                        <span>
                                            <%= user.streak || 1 %> DAYS STREAK
                                        </span>
                                    </div>
                    </div>

                    <!-- Profile Info Overlay Header -->
                    <div class="profile-header-content">
                        <div class="avatar-ring-pod">
                            <% if (user.avatar && user.avatar.trim() !=='' ) { %>
                                <img src="<%= user.avatar %>" alt="<%= user.username %>" class="user-avatar"
                                    referrerpolicy="no-referrer"
                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                <div class="user-avatar-fallback" style="display: none;">
                                    <i class="fa-solid fa-user"></i>
                                </div>
                                <% } else { %>
                                    <div class="user-avatar-fallback">
                                        <i class="fa-solid fa-user"></i>
                                    </div>
                                    <% } %>
                        </div>

                        <div class="user-details">
                            <h2 class="glitch-title gold-text" data-text="<%= user.username %>">
                                <%= user.username %>
                            </h2>
                            <p class="user-email"><i class="fa-regular fa-envelope cyan-text"></i>
                                <%= user.email %>
                            </p>
                            <% if (user.bio) { %>
                                <p class="user-bio-preview">"<%= user.bio %>"</p>
                                <% } %>
                        </div>
                    </div>

                    <hr class="profile-divider">

                    <!-- User Stats & Metrics Grid -->
                    <div class="profile-stats-grid">
                        <div class="stat-card">
                            <div class="stat-icon-pod gold-icon">
                                <i class="fa-solid fa-coins"></i>
                            </div>
                            <div class="stat-info">
                                <span class="stat-label">EP BALANCE</span>
                                <h4 class="gold-text">
                                    <%= (user.xpBalance || 0).toLocaleString() %> EP
                                </h4>
                            </div>
                        </div>

                        <div class="stat-card">
                            <div class="stat-icon-pod cyan-icon">
                                <i class="fa-solid fa-check-double"></i>
                            </div>
                            <div class="stat-info">
                                <span class="stat-label">QUIZZES SOLVED</span>
                                <h4 class="cyan-text">
                                    <%= user.quizzesCompleted || 0 %>
                                </h4>
                            </div>
                        </div>

                        <div class="stat-card">
                            <div class="stat-icon-pod gold-icon">
                                <i class="fa-solid fa-ranking-star"></i>
                            </div>
                            <div class="stat-info">
                                <span class="stat-label">WEEKLY SCORE</span>
                                <h4 class="gold-text">
                                    <%= user.weeklyScore || 0 %> PTS
                                </h4>
                            </div>
                        </div>
                    </div>

                    <hr class="profile-divider">

                    <!-- Customization Forms Stack -->
                    <div class="customization-sections">
                        <!-- 1. Banner Update Form -->
                        <form action="/profile/banner" method="POST" enctype="multipart/form-data" class="profile-form">
                            <label class="form-label">
                                <i class="fa-solid fa-image gold-text"></i> UPDATE BANNER ARTWORK
                            </label>
                            <div class="file-upload-wrapper">
                                <label for="bannerInput" class="custom-file-btn">
                                    <i class="fa-solid fa-folder-open cyan-text"></i>
                                    <span id="bannerFileName">Choose Banner Image...</span>
                                </label>
                                <input type="file" id="bannerInput" name="banner" accept="image/*" required
                                    onchange="document.getElementById('bannerFileName').textContent = this.files[0]?.name || 'Choose Banner Image...';">
                                <button type="submit" class="hotstar-btn primary-btn upload-action-btn">
                                    <i class="fa-solid fa-cloud-arrow-up"></i> Upload
                                </button>
                            </div>
                        </form>

                        <!-- 2. Avatar Update Form -->
                        <form action="/profile/avatar" method="POST" enctype="multipart/form-data" class="profile-form">
                            <label class="form-label">
                                <i class="fa-solid fa-circle-user gold-text"></i> UPDATE AVATAR PICTURE
                            </label>
                            <div class="file-upload-wrapper">
                                <label for="avatarInput" class="custom-file-btn">
                                    <i class="fa-solid fa-folder-open cyan-text"></i>
                                    <span id="avatarFileName">Choose Avatar Image...</span>
                                </label>
                                <input type="file" id="avatarInput" name="avatar" accept="image/*" required
                                    onchange="document.getElementById('avatarFileName').textContent = this.files[0]?.name || 'Choose Avatar Image...';">
                                <button type="submit" class="hotstar-btn primary-btn upload-action-btn">
                                    <i class="fa-solid fa-cloud-arrow-up"></i> Upload
                                </button>
                            </div>
                        </form>

                        <!-- 3. Profile Info & Social IDs Form -->
                        <form action="/profile/update" method="POST" class="profile-form">
                            <label class="form-label">
                                <i class="fa-solid fa-user-pen gold-text"></i> OPERATOR DETAILS & CREDENTIALS
                            </label>

                            <div class="form-group">
                                <label for="username" class="sub-label">Callsign / Username</label>
                                <input type="text" id="username" name="username" value="<%= user.username %>" required
                                    minlength="3" maxlength="25" class="cyber-input">
                            </div>

                            <div class="form-group-row">
                                <div class="form-group">
                                    <label for="platoId" class="sub-label">
                                        <i class="fa-solid fa-gamepad cyan-text"></i> Plato ID
                                    </label>
                                    <input type="text" id="platoId" name="platoId" value="<%= user.platoId || '' %>"
                                        maxlength="12" pattern="^[a-zA-Z0-9_]{1,12}$"
                                        title="Plato ID must be up to 12 characters and contain only letters, numbers, and underscores (no spaces or special characters)."
                                        placeholder="e.g. username_99" class="cyber-input">
                                </div>
                                <div class="form-group">
                                    <label for="discordId" class="sub-label">
                                        <i class="fa-brands fa-discord cyan-text"></i> Discord ID
                                    </label>
                                    <input type="text" id="discordId" name="discordId"
                                        value="<%= user.discordId || '' %>" placeholder="username#0000"
                                        class="cyber-input">
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="bio" class="sub-label">Bio</label>
                                <textarea id="bio" name="bio" rows="3" maxlength="250" class="cyber-input"
                                    placeholder="Write something about yourself..."
                                    style="resize: none;"><%= user.bio || '' %></textarea>
                            </div>

                            <button type="submit" class="hotstar-btn primary-btn"
                                style="margin-top: 0.5rem; width: 100%;">
                                <i class="fa-solid fa-floppy-disk"></i> SAVE PROFILE CHANGES
                            </button>
                        </form>
                    </div>
                </div>
            </main>
            <!-- 320x50 ADSTERRA BANNER -->
            <div class="adsterra-banner-container"
                style="display: flex; justify-content: center; align-items: center; margin: 1rem 0; width: 100%; min-height: 50px; overflow: hidden;">
                <script>
                    atOptions = {
                        'key': '9019d2b26f252f4c581c4f2432bac432',
                        'format': 'iframe',
                        'height': 50,
                        'width': 320,
                        'params': {}
                    };
                </script>
                <script src="https://www.highperformanceformat.com/9019d2b26f252f4c581c4f2432bac432/invoke.js"></script>
            </div>
            <%- include('partials/footer') %>
</body>

</html>