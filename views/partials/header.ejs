<header class="app-header-unified">
    <div class="header-container">

        <!-- Left: Brand Logo & Title -->
        <a href="/" class="nav-brand">
            <img src="/images/atx-logo.png" alt="ATX Logo" class="nav-logo" onerror="this.src='/images/atx.webp';">
            <span class="shimmer-text">ATX</span>
        </a>

        <!-- Center: Primary Navigation Links (Desktop) -->
        <nav class="nav-links-desktop">
            <a href="/" class="nav-item">Home</a>
            <a href="/about" class="nav-item">About</a>
            <a href="/winners" class="nav-item">Winners</a>
            <a href="/xpl" class="nav-item">XPL</a>
            <a href="/admin-team" class="nav-item">Our Team</a>
            <% if (typeof isAdmin !=='undefined' && isAdmin) { %>
                <a href="/admin/dashboard" class="nav-item admin-nav-link">
                    <i class="fa-solid fa-user-shield gold-text"></i> Admin
                </a>
                <% } %>
        </nav>

        <!-- Right: Actions -->
        <div class="header-actions">
            <!-- Theme Selector (Desktop) -->
            <div class="theme-select-wrapper desktop-theme-select">
                <i class="fa-solid fa-palette cyan-text theme-icon"></i>
                <select id="themeSelector" class="header-select theme-switcher" aria-label="Select Theme">
                    <option value="cyber-dark">Dark</option>
                    <option value="gold-neon">Gold</option>
                    <option value="light-white">Light</option>
                </select>
            </div>

            <!-- Dynamic Auth Controls -->
            <% if (user) { %>
                <a href="/profile" class="user-pill" title="Operator Profile">
                    <i class="fa-solid fa-user-astronaut"></i>
                    <span class="user-name">
                        <%= user.username %>
                    </span>
                </a>
                <a href="/logout" class="auth-btn logout-btn" title="Logout">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span class="btn-text">Logout</span>
                </a>
                <% } else { %>
                    <a href="/login" class="auth-btn login-btn">
                        <i class="fa-solid fa-right-to-bracket"></i>
                        <span class="btn-text">Login</span>
                    </a>
                    <% } %>

                        <!-- Mobile Menu Toggle Button -->
                        <button id="navToggle" class="nav-toggle" aria-label="Toggle Navigation" type="button">
                            <i class="fa-solid fa-bars"></i>
                        </button>
        </div>
    </div>

    <!-- Mobile Drawer Container -->
    <div id="mobileDrawer" class="mobile-drawer">
        <div class="mobile-theme-row">
            <span class="mobile-theme-label"><i class="fa-solid fa-palette cyan-text"></i>Theme:</span>
            <div class="theme-select-wrapper">
                <select id="themeSelectorMobile" class="header-select theme-switcher" aria-label="Select Mobile Theme">
                    <option value="cyber-dark">Dark</option>
                    <option value="gold-neon">Gold</option>
                    <option value="light-white">Light</option>
                </select>
            </div>
        </div>

        <div class="drawer-links">
            <a href="/" class="drawer-item"><i class="fa-solid fa-house cyan-text"></i> Home</a>
            <a href="/about" class="drawer-item"><i class="fa-solid fa-book-open gold-text"></i> About</a>
            <a href="/winners" class="drawer-item"><i class="fa-solid fa-trophy gold-text"></i> Winners</a>
            <a href="/xpl" class="drawer-item"><i class="fa-solid fa-bolt cyan-text"></i> XPL League</a>
            <a href="/admin-team" class="drawer-item"><i class="fa-solid fa-users gold-text"></i> Our Team</a>
            <% if (typeof isAdmin !=='undefined' && isAdmin) { %>
                <a href="/admin/dashboard" class="drawer-item admin-drawer-link">
                    <i class="fa-solid fa-user-shield gold-text"></i> Admin Panel
                </a>
                <% } %>
        </div>
    </div>
</header>