<% if (locals.success_msg && success_msg.length> 0) { %>
    <div class="flash-alert flash-success" id="flashMsg">
        <div class="flash-content">
            <i class="fa-solid fa-circle-check"></i>
            <span>
                <%= success_msg %>
            </span>
        </div>
        <button type="button" class="flash-close" onclick="dismissFlash()">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
    <% } %>

        <% if (locals.error_msg && error_msg.length> 0) { %>
            <div class="flash-alert flash-error" id="flashMsg">
                <div class="flash-content">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <span>
                        <%= error_msg %>
                    </span>
                </div>
                <button type="button" class="flash-close" onclick="dismissFlash()">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <% } %>

                <script>
                    function dismissFlash() {
                        const flash = document.getElementById('flashMsg');
                        if (flash) {
                            flash.classList.add('flash-fade-out');
                            setTimeout(() => flash.remove(), 400); // Remove element after animation
                        }
                    }

                    // Auto dismiss after 4 seconds
                    document.addEventListener('DOMContentLoaded', () => {
                        const flash = document.getElementById('flashMsg');
                        if (flash) {
                            setTimeout(() => {
                                dismissFlash();
                            }, 4000);
                        }
                    });
                </script>