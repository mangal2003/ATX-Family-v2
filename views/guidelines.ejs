<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
        <link rel="stylesheet" href="/css/guidelines.css">
</head>

<body>
    <%- include('partials/header') %>
        <%- include('partials/flash') %>

            <main class="directives-wrapper">
                <!-- Header Banner -->
                <header class="terminal-header">
                    <h1 class="terminal-title" data-text="EVENT SPONSORSHIP PROTOCOL">EVENT SPONSORSHIP <span
                            class="gold-text">PROTOCOL</span></h1>
                    <p class="terminal-subtitle">
                        Framework for member-sponsored birthday events, commemorative tours, and custom server
                        tournaments.
                    </p>
                </header>

                <!-- Timeline Steps -->
                <div class="directive-steps-stack">

                    <!-- Step 1 -->
                    <article class="directive-step-card active-step">
                        <div class="step-header">
                            <span class="step-number">STEP 01</span>
                            <i class="fa-solid fa-headset gold-text"></i>
                        </div>
                        <h2 class="step-title">Submit Staff Ticket</h2>
                        <p class="step-desc">
                            Before announcing any member-sponsored event, you must log a formal request ticket. All
                            planning, prizes, and timing must be confirmed prior to public posting.
                        </p>

                        <div class="discord-action-bar">
                            <span class="discord-action-text"><i class="fa-brands fa-discord"></i> Open Ticket
                                &raquo;
                            </span>
                            <a href="<%= locals.links ? links.discord_contact_staff : '#' %>" target="_blank"
                                class="discord-btn">
                                Contact Staff <i class="fa-solid fa-arrow-up-right-from-square"></i>
                            </a>
                        </div>
                    </article>

                    <!-- Step 2 -->
                    <article class="directive-step-card">
                        <div class="step-header">
                            <span class="step-number">STEP 02</span>
                            <i class="fa-solid fa-user-shield cyan-text"></i>
                        </div>
                        <h2 class="step-title">Assign Lead Organiser</h2>
                        <p class="step-desc">
                            Each event requires <strong>ONE (1) Lead Organiser</strong> who acts as the primary
                            contact with <strong>ONE (1) assigned Staff Representative</strong>.
                        </p>
                        <p class="step-desc" style="color: #9ca3af; font-size: 0.78rem;">
                            * For multi-sponsor events, organisers must provide a clear claim allocation list
                            following our standard prize distribution system.
                        </p>
                    </article>

                    <!-- Step 3 -->
                    <article class="directive-step-card">
                        <div class="step-header">
                            <span class="step-number">STEP 03</span>
                            <i class="fa-solid fa-list-check cyan-text"></i>
                        </div>
                        <h2 class="step-title">Required Information Checklist</h2>
                        <p class="step-desc">Your staff ticket submission must include the following finalized
                            details:</p>

                        <div class="checklist-grid">
                            <div class="check-chip"><i class="fa-solid fa-calendar-day"></i> Confirmed Date & Time
                            </div>
                            <div class="check-chip"><i class="fa-solid fa-gamepad"></i> Plato / Discord Activities
                            </div>
                            <div class="check-chip"><i class="fa-solid fa-microphone"></i> Assigned Event Hosts
                            </div>
                            <div class="check-chip"><i class="fa-solid fa-image"></i> Posters & Visual Assets</div>
                            <div class="check-chip"><i class="fa-solid fa-clover"></i> Special Requests (Wheel Spins
                                / GA)</div>
                            <div class="check-chip"><i class="fa-solid fa-wallet"></i> Sponsor Roster & Amounts
                            </div>
                        </div>
                    </article>

                </div>

                <!-- Mandatory Rules Callout -->
                <footer class="rules-notice-card">
                    <div class="notice-title">
                        <i class="fa-solid fa-triangle-exclamation"></i> MANDATORY EXECUTION POLICIES
                    </div>
                    <ul class="notice-list">
                        <li>Staff holds final authority on event scheduling, format, and execution mechanics.</li>
                        <li>Member-sponsored events will <strong>NOT</strong> change server identity assets (group
                            avatar or server name) unless explicitly authorized by senior administration.</li>
                    </ul>
                </footer>
            </main>

            <%- include('partials/footer') %>
</body>

</html>