<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
        <link rel="stylesheet" href="/css/features.css">
</head>

<body>
    <%- include('partials/header') %>
        <%- include('partials/flash') %>

            <main class="arsenal-wrapper">
                <!-- COMMAND CENTER HERO -->
                <section class="arsenal-hud-hero">
                    <div class="hud-scanline"></div>
                    <div class="hud-meta-header">
                        <span class="hud-pill-tag"><i class="fa-solid fa-bolt-lightning"></i> WHY WE ARE
                            DIFFERENT</span>

                    </div>

                    <h1 class="arsenal-glitch-title" data-text="CYBER ARSENAL">UNIQUE <span
                            class="gold-gradient-text">FEATURES</span></h1>
                    <p class="arsenal-subtitle">
                        Advanced architectural capabilities, real-time engines, and custom features you won't find in
                        any other GC
                    </p>

                    <% if (currentUser && currentUser.role==='admin' ) { %>
                        <div class="arsenal-admin-action">
                            <button class="cyber-btn init-feature-btn" onclick="openAddModal()">
                                <i class="fa-solid fa-plus-circle"></i> ADD NEW FEATURE
                            </button>
                        </div>
                        <% } %>
                </section>

                <!-- ASYMMETRIC BENTO DIRECTIVE MATRIX -->
                <section class="bento-matrix-container">
                    <% if (!features || features.length===0) { %>
                        <div class="empty-matrix-card">
                            <i class="fa-solid fa-satellite-dish gold-text"></i>
                            <h3>NO FEATURES DEPLOYED YET</h3>
                            <p>System awaiting administrative deployment directives.</p>
                        </div>
                        <% } else { %>
                            <div class="bento-grid">
                                <% features.forEach((feature, index)=> { %>
                                    <article class="bento-card <%= index === 0 ? 'spotlight-card' : '' %>"
                                        data-index="<%= index %>">
                                        <!-- Background Image & Gradients -->
                                        <div class="bento-backdrop"
                                            style="background-image: url('<%= feature.bgImage || '/images/atx.webp' %>');">
                                        </div>
                                        <div class="bento-grid-overlay"></div>
                                        <div class="bento-scan-bar"></div>

                                        <!-- Cyber HUD Corner Brackets -->
                                        <div class="hud-corner tl"></div>
                                        <div class="hud-corner tr"></div>
                                        <div class="hud-corner bl"></div>
                                        <div class="hud-corner br"></div>

                                        <!-- Admin Quick Controls -->
                                        <% if (currentUser && currentUser.role==='admin' ) { %>
                                            <div class="bento-admin-dock">
                                                <button class="dock-btn edit" title="Edit Module"
                                                    data-feature="<%= JSON.stringify(feature) %>"
                                                    onclick="openEditModal(this)">
                                                    <i class="fa-solid fa-sliders"></i>
                                                </button>

                                                <form action="/features/delete" method="POST"
                                                    onsubmit="return confirm('Decommission this module?');">
                                                    <input type="hidden" name="featureId" value="<%= feature._id %>">
                                                    <button type="submit" class="dock-btn delete"
                                                        title="Decommission Module">
                                                        <i class="fa-solid fa-power-off"></i>
                                                    </button>
                                                </form>
                                            </div>
                                            <% } %>

                                                <!-- Card Body -->
                                                <div class="bento-content">
                                                    <div class="bento-header-meta">
                                                        <div class="neon-icon-pod">
                                                            <span class="module-emoji">
                                                                <%= feature.icon || '⚡' %>
                                                            </span>
                                                        </div>
                                                        <div class="telemetry-info">
                                                            <!-- <span class="telemetry-rank"><%= index + 1 %>
                                                            </span> -->
                                                            <span class="telemetry-priority">
                                                                <%= feature.order || 0 %>
                                                            </span>
                                                        </div>
                                                    </div>

                                                    <div class="bento-text-group">
                                                        <h3 class="bento-title">
                                                            <%= feature.heading %>
                                                        </h3>
                                                        <p class="bento-desc">
                                                            <%= feature.about %>
                                                        </p>
                                                    </div>

                                                    <!-- <div class="bento-footer-hud">
                                                        <span class="hud-indicator"><i
                                                                class="fa-solid fa-shield-halved"></i> ATX
                                                            VERIFIED</span>
                                                        <span class="hud-link-bracket"><i
                                                                class="fa-solid fa-angle-right"></i></span>
                                                    </div> -->
                                                </div>
                                    </article>
                                    <% }) %>
                            </div>
                            <% } %>
                </section>
            </main>

            <!-- ADMIN MODALS -->
            <% if (currentUser && currentUser.role==='admin' ) { %>
                <!-- Add Directive Modal -->
                <div id="addModal" class="cyber-modal">
                    <div class="modal-content">
                        <button type="button" class="modal-close" onclick="closeModal('addModal')">&times;</button>
                        <div class="modal-header-bar">
                            <h3><i class="fa-solid fa-microchip gold-text"></i> ADD NEW</h3>
                        </div>

                        <form action="/features/add" method="POST" enctype="multipart/form-data">
                            <div class="modal-field">
                                <label>Feature Emoji</label>
                                <input type="text" name="icon" placeholder="⚡, 🏆, 👑, 🎧" required>
                            </div>

                            <div class="modal-field">
                                <label>Feature Title</label>
                                <input type="text" name="heading" placeholder="e.g. THE AUCTION HOUSE" required>
                            </div>

                            <div class="modal-field">
                                <label>Background Image</label>
                                <input type="file" name="bgImageFile" accept="image/*" class="custom-file-input"
                                    required>
                            </div>

                            <div class="modal-field">
                                <label>Priority</label>
                                <span style="color: var(--text-mute); font-size: 10px;">1 more than total
                                    features</span>
                                <input type="number" name="order" value="0">
                            </div>

                            <div class="modal-field">
                                <label>Description</label>
                                <textarea name="about" rows="3" placeholder="Write something about it..."
                                    required></textarea>
                            </div>

                            <button type="submit" class="cyber-btn modal-submit-btn">
                                <i class="fa-solid fa-bolt"></i> SAVE
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Edit Directive Modal -->
                <div id="editModal" class="cyber-modal">
                    <div class="modal-content">
                        <button type="button" class="modal-close" onclick="closeModal('editModal')">&times;</button>
                        <div class="modal-header-bar">
                            <h3><i class="fa-solid fa-sliders cyan-text"></i> EDIT DETAILS</h3>
                        </div>

                        <form action="/features/update" method="POST" enctype="multipart/form-data">
                            <input type="hidden" name="featureId" id="editFeatureId">
                            <input type="hidden" name="existingBgImage" id="editExistingBgImage">

                            <div class="modal-field">
                                <label>Change Emoji</label>
                                <input type="text" name="icon" id="editIcon" required>
                            </div>

                            <div class="modal-field">
                                <label>Change Title</label>
                                <input type="text" name="heading" id="editHeading" required>
                            </div>

                            <div class="modal-field">
                                <label>Replace Background Image</label>
                                <input type="file" name="bgImageFile" accept="image/*" class="custom-file-input">
                            </div>

                            <div class="modal-field">
                                <label>Change Priority</label>
                                <span style="color: var(--text-mute); font-size: 10px;">First change the priority of
                                    existing features at the place you want to switch (if any)</span>
                                <input type="number" name="order" id="editOrder">
                            </div>

                            <div class="modal-field">
                                <label>Change Description</label>
                                <textarea name="about" id="editAbout" rows="3" required></textarea>
                            </div>

                            <button type="submit" class="cyber-btn modal-submit-btn">
                                <i class="fa-solid fa-floppy-disk"></i> SAVE CHANGES
                            </button>
                        </form>
                    </div>
                </div>
                <% } %>

                    <!-- SCRIPT LOGIC -->
                    <script>
                        function openAddModal() {
                            document.getElementById('addModal').classList.add('active');
                        }

                        function openEditModal(btn) {
                            const feature = JSON.parse(btn.getAttribute('data-feature'));
                            document.getElementById('editFeatureId').value = feature._id;
                            document.getElementById('editExistingBgImage').value = feature.bgImage || '';
                            document.getElementById('editIcon').value = feature.icon || '⚡';
                            document.getElementById('editHeading').value = feature.heading || '';
                            document.getElementById('editOrder').value = feature.order || 0;
                            document.getElementById('editAbout').value = feature.about || '';
                            document.getElementById('editModal').classList.add('active');
                        }

                        function closeModal(modalId) {
                            document.getElementById(modalId).classList.remove('active');
                        }

                        window.onclick = function (event) {
                            if (event.target.classList.contains('cyber-modal')) {
                                event.target.classList.remove('active');
                            }
                        };
                    </script>

                    <%- include('partials/footer') %>
</body>

</html>